{
  "name": "dsh-airremote",
  "version": "0.5.2",
  "description": "DSH plugin for Codex Air Remote: exposes the ESP32-C6 board as a virtual microphone for the official DSH voice-input plugin (board PCM over WSS, local recognition, draft write), plus board flashing and provisioning.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets",
    "firmware",
    "scripts/bundle-firmware.mjs",
    "LICENSE",
    "LICENSE-dsh-ears.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1",
    "react": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node test/integration.mjs && node test/client-bundle.mjs && node test/browser.mjs",
    "test:host": "node test/integration.mjs",
    "test:client": "node test/client-bundle.mjs",
    "test:browser": "node test/browser.mjs",
    "test:e2e": "node test/e2e-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "rolldown": "~1.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "esptool-js": "^0.7.1",
    "serialport": "^13.0.0"
  },
  "author": "grassoflty-dev and contributors",
  "homepage": "https://github.com/grassoflty-dev/CodexAirRemote/tree/main/plugins/dsh-airremote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grassoflty-dev/CodexAirRemote.git",
    "directory": "plugins/dsh-airremote"
  },
  "bugs": {
    "url": "https://github.com/grassoflty-dev/CodexAirRemote/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "esp32",
    "esp32-c6",
    "voice-input",
    "whisper",
    "firmware-flashing",
    "wake-word"
  ]
}
